---
import { Font } from "astro:assets";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Lyric Render 9:16",
  description = "Render de letras estilo app de música en 9:16 u 16:9. Fondo blur animado, letra + traducción, graba a .webm.",
} = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#14120e" />
    <meta name="color-scheme" content="dark" />
    <!-- Quicksand servida en local por Astro (Fontsource): con preload
         evitamos el @import bloqueante de Google Fonts del index.html original. -->
    <Font cssVariable="--font-quicksand" preload />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='14' fill='%23c98a5e'/%3E%3Ccircle cx='16' cy='16' r='6' fill='%23a86ad8'/%3E%3C/svg%3E" />
  </head>
  <body>
    <slot />
  </body>
</html>
